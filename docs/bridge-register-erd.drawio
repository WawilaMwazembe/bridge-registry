          <mxGeometry height="150" width="300" x="40" y="800" as="geometry" />
        </mxCell>
        <mxCell id="c96" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=4;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Legend&lt;/b&gt;&amp;nbsp;&amp;nbsp; &lt;b&gt;&lt;u&gt;PK&lt;/u&gt;&lt;/b&gt; primary key &amp;nbsp;·&amp;nbsp; &lt;b&gt;FK&lt;/b&gt; foreign key &amp;nbsp;·&amp;nbsp; UK unique (bridge_no unique among live, non-duplicate records) &amp;nbsp;·&amp;nbsp; crow&#39;s foot = many, bar = one, circle = optional &amp;nbsp;·&amp;nbsp; dashed line = logical link maintained by trigger, not an FK constraint.&lt;br&gt;&lt;b&gt;Triggers on bridge:&lt;/b&gt; BEFORE INSERT/UPDATE sets version, server_seq, created/updated by+at and clears verification when data changes (with an advisory lock so sync never skips a change) · AFTER INSERT/UPDATE writes bridge_history · BEFORE DELETE blocks hard deletes (use is_deleted).&lt;br&gt;&lt;b&gt;Lookup FKs&lt;/b&gt; use ON UPDATE CASCADE, so renaming a value in the Admin screen updates every bridge.&lt;br&gt;&lt;b&gt;Colours:&lt;/b&gt; blue = lookup tables · yellow = core data · green = users &amp;amp; sessions · grey = audit." vertex="1">
          <mxGeometry height="120" width="1120" x="40" y="970" as="geometry" />
        </mxCell>
